<Window x:Class="Iit.Fibertest.Licenser.AskVersionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="150" Width="400" WindowStartupLocation="CenterScreen">
    <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="10,20,10,10" >
            <Button Name="Ft2Button" Visibility="{Binding OkVisibility}" Content="Fibertest 2.0" Margin="5"  FontSize="20"
                IsDefault="True" HorizontalAlignment="Center" Width="140" Height="40"/>
            <Button Name="Ft3Button" Visibility="{Binding CancelVisibility}"  FontSize="20"
                Content="Fibertest 3.0" Margin="30,5,5,5" HorizontalAlignment="Center" Width="140"/>
        </StackPanel>
    </StackPanel>

</Window>
